# ==============================================================================
# LMS Multi-User Platform Environment Variables (Example)
# DO NOT COMMIT REAL SECRETS TO GIT
# ==============================================================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database & Auth (Project URL and Anon Key for client/backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here

# Supabase Service Role Key (Server-side ONLY for admin migrations/storage management)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# AES-256 Fernet Encryption Key for LMS Passwords at rest (generate with Fernet.generate_key().decode())
LMS_CREDENTIAL_ENCRYPTION_KEY=generate_fernet_key_here

# Application Port and Host
APP_HOST=127.0.0.1
APP_PORT=8000

